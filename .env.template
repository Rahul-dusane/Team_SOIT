# HireLens Backend Configuration Template
# Copy this file to .env and update with your actual values

# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# Choose which LLM provider to use: 'openai' or 'gemini'
LLM_PROVIDER=openai

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Database type: 'sqlite' or 'postgresql'
DATABASE_TYPE=sqlite

# PostgreSQL configuration (required if DATABASE_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/hirelens
PGVECTOR_ENABLED=true

# SQLite configuration (used if DATABASE_TYPE=sqlite)
SQLITE_DB_PATH=hirelens.db

# ============================================================
# VECTOR EMBEDDING CONFIGURATION
# ============================================================
# Embedding model to use
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================
# API AUTHENTICATION
# ============================================================
# Set to 'true' to require API key authentication
REQUIRE_AUTH=false

# API key for authentication (if REQUIRE_AUTH=true)
API_KEY=your_api_key_here

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# Environment: 'development' or 'production'
ENVIRONMENT=development

# Server host and port
HOST=0.0.0.0
PORT=8000

# ============================================================
# TESTING CONFIGURATION
# ============================================================
# Set to 'true' to bypass authentication during testing
TESTING=false

# ============================================================
# MATCHING ENGINE CONFIGURATION
# ============================================================
# Minimum evidence coverage threshold (0.0 to 1.0)
MIN_EVIDENCE_COVERAGE=0.60

# Confidence level thresholds
HIGH_CONFIDENCE_THRESHOLD=0.85
LOW_CONFIDENCE_THRESHOLD=0.60

# Skill matching thresholds for semantic similarity
TRANSFERABLE_SKILL_THRESHOLD=0.78
RELATED_SKILL_THRESHOLD=0.65

# Mandatory failure policy: 'reject' or 'flag'
MANDATORY_FAILURE_POLICY=reject

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
LOG_LEVEL=INFO
